# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
MCP_BASE_PATH=/mcp
LOG_LEVEL=INFO

# ── Data directory ────────────────────────────────────────────────────────────
ERDDAP_DATA_DIR=/app/data

# ── Docker ────────────────────────────────────────────────────────────────────
# Prevents Docker network conflicts when multiple MCPs share the droplet.
COMPOSE_PROJECT_NAME=erddap-mcp
