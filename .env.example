# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
MCP_BASE_PATH=/mcp
LOG_LEVEL=INFO

# ── Storage (S3 + DynamoDB) ───────────────────────────────────────────────────
# El task role de Fargate provee las credenciales — no hace falta poner
# AWS_ACCESS_KEY_ID/SECRET acá en producción.
AWS_REGION=us-west-2
ERDDAP_S3_BUCKET=erddap-mcp-data
ERDDAP_S3_PREFIX=erddap
ERDDAP_DYNAMODB_TABLE=erddap-catalog

# ── Auth por API-key (tabla compartida entre los 3 MCP de ChatMPA) ───────────
AUTH_DYNAMODB_TABLE=chatmpa-investigator-keys

# ── Docker ────────────────────────────────────────────────────────────────────
# Prevents Docker network conflicts when multiple MCPs share the droplet.
COMPOSE_PROJECT_NAME=erddap-mcp
